{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Capability Announcement",
  "type": "object",
  "patternProperties": {
    "^[a-z]+$": {
      "type": "object",
      "properties": {
        "announced_at": { "type": "string", "format": "date-time" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "models_available": { "type": "array", "items": { "type": "string" } },
        "health_status": { "type": "string", "enum": ["available", "unavailable", "degraded"] },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["announced_at", "capabilities", "models_available"]
    }
  }
}
